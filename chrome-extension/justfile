# Показать список команд
default:
    @just --list

# 1. Получить чистый текст страницы
text:
    @echo "Запрашиваю текст страницы..."
    curl -X POST -d "get_text" http://localhost:3001

# 2. Скачать полный HTML слепок (с фиксами для редакторов кода)
# Результат сохраняется в файл snapshot.html, чтобы не засорять терминал
html:
    @echo "Генерирую HTML слепок..."
    curl -X POST -d "dump_html" http://localhost:3001 > snapshot.html
    @echo "Готово! Файл сохранен как snapshot.html"

# 3. Включить интерактивный режим копирования при скролле
# После запуска нужно кликнуть элемент в браузере, проскроллить и кликнуть еще раз
scroll:
    @echo "Активация режима Scroll Copy..."
    curl -X POST -d "copy_scroll" http://localhost:3001

# Запуск моста (нужно запускать в отдельном терминале)
serve:
    node bridge.js
